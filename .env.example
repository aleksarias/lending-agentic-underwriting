# Copy to .env (gitignored; chmod 600). This is the ONLY place credentials live.
# Admin (you): OAuth U2M. Run `databricks auth login --host <host> --profile lending-dev` once;
# the refresh token is kept in the OS keychain, the profile file holds no secret.
DATABRICKS_HOST=https://dbc-67e8cd43-5f63.cloud.databricks.com
DATABRICKS_AUTH_TYPE=databricks-cli
DATABRICKS_CONFIG_PROFILE=lending-dev2
# Alternative to OAuth (not recommended): DATABRICKS_TOKEN=

ANTHROPIC_API_KEY=
# Required if the key is not scoped to a workspace (Console -> Settings -> Workspaces -> ID)
ANTHROPIC_WORKSPACE_ID=

# Written by `lau init` (service principals, OAuth M2M)
LAU_HARNESS_CLIENT_ID=
LAU_HARNESS_CLIENT_SECRET=
LAU_AGENT_CLIENT_ID=
LAU_AGENT_CLIENT_SECRET=
LAU_PROMOTER_CLIENT_ID=
LAU_PROMOTER_CLIENT_SECRET=
LAU_UI_CLIENT_ID=
LAU_UI_CLIENT_SECRET=

LAU_MASKING_SALT=
